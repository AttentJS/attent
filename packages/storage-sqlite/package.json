{
  "name": "@attent/storage-sqlite",
  "version": "0.0.1",
  "description": "Durable SQLite adapters for Attent's IdentityStore, RevocationStore, and AuditSink",
  "keywords": [
    "attent",
    "sqlite",
    "storage",
    "durable",
    "authorization"
  ],
  "homepage": "https://github.com/AttentJS/attent#readme",
  "bugs": {
    "url": "https://github.com/AttentJS/attent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AttentJS/attent.git",
    "directory": "packages/storage-sqlite"
  },
  "license": "MIT",
  "author": "AttentJS",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "attent": "file:../..",
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
